LBG_DIALOGUE_ADMIN_TOKEN="aEKNu9kvj2PwQnt06AMfHs9vHD7h_XAZXcRSs0QW3o8"
# Autorise le modèle à suggérer une action monde bornée via "ACTION_JSON:" (aid uniquement).
# Désactivé par défaut.
LBG_DIALOGUE_WORLD_ACTIONS="1"
# Palier par défaut : auto + failover (Groq d'abord, qwen3.8:27b si échec Groq)
LBG_DIALOGUE_TARGET_DEFAULT="auto"
# Ordre mode auto (1er palier disponible) ; GLM reste accessible via dialogue_target=glm explicite
LBG_DIALOGUE_AUTO_ORDER="fast,local,remote"
LBG_DIALOGUE_FAILOVER="1"
LBG_DIALOGUE_FAILOVER_ORDER="fast,local"


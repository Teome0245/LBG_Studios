[Unit]
Description=LBG Light Web Enrich (Ollama 111 + Wikipedia/DDG)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/lbg-light-web-enrich
Environment=LBG_OLLAMA_BASE_URL=http://127.0.0.1:11434
Environment=LBG_WEB_ENRICH_MODEL=qwen2.5:3b
Environment=LBG_WEB_ENRICH_TIMEOUT_S=8
Environment=LBG_WEB_ENRICH_MAX_CHARS=1800
ExecStart=/opt/lbg-light-web-enrich/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8095
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

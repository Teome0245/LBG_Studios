[Unit]
Description=LBG linux_agent (mains Team .142)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lbg
WorkingDirectory=/opt/LBG_Studios/packages/cortex/linux_agent/Agent_IA
Environment=LBG_LINUX_ENV_PATH=/opt/LBG_Studios/packages/cortex/linux_agent/Agent_IA/linux.env
ExecStart=/opt/LBG_Studios/packages/cortex/linux_agent/Agent_IA/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 6001
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

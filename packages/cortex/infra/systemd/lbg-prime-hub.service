[Unit]
Description=LBG Prime Hub (Godot headless) lbg-ws/2
After=network.target

[Service]
Type=simple
User=lbg
WorkingDirectory=/opt/lbg-prime-hub
Environment=LBG_PRIME_HUB_WS_PORT=8787
Environment=LBG_PRIME_HUB_HTTP_PORT=8789
Environment=LBG_HUB_BUILDINGS_JSON=/opt/lbg-prime-hub/data/lost_heaven_buildings.json
Environment=LBG_HUB_AUTH_UPSTREAM=http://127.0.0.1:8797
Environment=LBG_HUB_HTTP_UPSTREAM=http://127.0.0.1:8797
ExecStart=/opt/lbg-prime-hub/tools/godot --headless --path /opt/lbg-prime-hub res://scenes/server_main.tscn
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

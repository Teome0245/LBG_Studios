[Unit]
Description=LBG équipe — sprint évolution 7j (audit full + L1 auto / L2 Pilot)
After=network-online.target lbg-orchestrator.service
Wants=lbg-orchestrator.service

[Service]
Type=oneshot
User=lbg
Group=lbg
EnvironmentFile=-/etc/lbg-ia-mmo.env
Environment=PYTHONPATH=/opt/LBG_IA_MMO/agents/src
Environment=LBG_TEAM_EVOLUTION_JOB_ENABLED=1
Environment=LBG_TEAM_EVOLUTION_L1_AUTO_RUN=1
Environment=LBG_ORCHESTRATOR_URL=http://127.0.0.1:8010
Environment=LBG_TEAM_EVOLUTION_JOB_STATE=/var/lib/lbg/team_evolution/state.json
Environment=LBG_TEAM_EVOLUTION_SPRINT_PATH=/var/lib/lbg/team_evolution/last_sprint.json
Environment=LBG_PRIME_CLIENT_ROOT=/opt/new_mmo/prime-client
TimeoutStartSec=900
ExecStart=/opt/LBG_IA_MMO/.venv/bin/python -m lbg_agents.spawn_team_evolution_sprint_job

[Install]
WantedBy=multi-user.target

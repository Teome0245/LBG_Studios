[Unit]
Description=LBG équipe virtuelle — sonde locks/snapshots vzdump Proxmox → tâche ops (L1)
After=network-online.target lbg-orchestrator.service
Wants=lbg-orchestrator.service

[Service]
Type=oneshot
User=lbg
Group=lbg
EnvironmentFile=-/etc/lbg-ia-mmo.env
Environment=PYTHONPATH=/opt/LBG_IA_MMO/agents/src
Environment=LBG_TEAM_OPS_LOCK_JOB_ENABLED=1
Environment=LBG_ORCHESTRATOR_URL=http://127.0.0.1:8010
Environment=LBG_TEAM_OPS_LOCK_JOB_STATE=/var/lib/lbg/team_ops_lock/state.json
Environment=LBG_TEAM_OPS_LOCK_JOB_ACTOR_ID=system:team_ops_lock
ExecStart=/opt/LBG_IA_MMO/.venv/bin/python -m lbg_agents.spawn_team_ops_lock_job

[Install]
WantedBy=multi-user.target

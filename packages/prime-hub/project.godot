; Engine configuration file for prime-hub (Godot headless authority).
; ADR 0026 §5 — même contrat lbg-ws/2 que hub_runtime / prime-client.

config_version=5

[application]

config/name="LBG Prime Hub"
config/description="Autorité hub Lost Heaven (headless) — spike Godot derrière lbg-ws/2"
run/main_scene="res://scenes/server_main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=0

[network]

limits/websocket/max_in_buffer_kb=16384
limits/websocket/max_out_buffer_kb=16384

[rendering]

renderer/rendering_method="gl_compatibility"
